# ==============================================================================
# MedRoute AI - Environment Variables Specification
# ==============================================================================

# Application Branding & Display Name
# Optional locally | Optional on Render
VITE_APP_TITLE=MedRoute AI

# Operational Mode
# Set to 'true' to run autonomous AMR navigation and AI inference simulation
# Required locally (defaults to true) | Required on Render
VITE_SIMULATION_MODE=true

# Optional External API Base URL
# Leave empty for pure static client-side mode with integrated telemetry engine.
# If connecting to an external REST / WebSocket telemetry backend, set full URL:
# Example: https://api.medroute.yourdomain.com
# Optional locally | Optional on Render
VITE_API_URL=
